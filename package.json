{
  "name": "agentos-for-projects",
  "version": "0.1.0",
  "description": "Project-owned context layer for model-agnostic coding agents.",
  "type": "module",
  "bin": {
    "agentos": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "test": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\" && node --test",
    "smoke": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\" && node ./test/smoke.js",
    "test:package-managers": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\" && node ./test/package-managers.js",
    "prepack": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "agents",
    "agentos",
    "claude-code",
    "codex",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
